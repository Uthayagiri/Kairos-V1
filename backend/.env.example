# Kairos Backend Configuration (Phase E.4 Authentication & Security)

# Server Runtime
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kairos_db?schema=public"

# Cross-Origin Resource Sharing (CORS)
# Comma-separated allowed origins (Do NOT use wildcard * in production)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# JWT Authentication & Tokens
# In production, both secrets must be at least 32 cryptographically secure characters
JWT_ACCESS_SECRET="kairos-development-jwt-access-secret-minimum-32-chars"
JWT_REFRESH_SECRET="kairos-development-jwt-refresh-secret-minimum-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Rate Limiting
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

