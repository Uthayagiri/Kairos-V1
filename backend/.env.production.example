# Kairos Backend Production Configuration (Phase E.7)
# Copy to backend/.env when running in production mode.

# Server Runtime
PORT=5000
NODE_ENV=production
HOST=0.0.0.0

# Database Connection (Local PostgreSQL)
# Example: postgresql://<user>:<password>@localhost:5432/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/kairos_prod?schema=public"

# Cross-Origin Resource Sharing (CORS)
# Set to the exact URL of your deployed public static frontend (e.g., Cloudflare Pages, Vercel, Netlify)
# Wildcards (*) are strictly forbidden in production.
CORS_ORIGIN="https://kairos-app.pages.dev,https://kairos-app.vercel.app"

# JWT Authentication & Cryptographic Tokens
# MUST be generated using high-entropy random strings (minimum 32 characters each)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_random_32_char_minimum_secret_key_1234567890"
JWT_REFRESH_SECRET="replace_with_another_random_32_char_minimum_refresh_key_1234567890"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# Rate Limiting
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20
